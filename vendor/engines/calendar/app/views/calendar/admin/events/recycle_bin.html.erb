<% title "recycle_bin" %>
<% breadcrumb :events_recycle_bin %>
<div class="text-right btn-group-responsive" style="margin-bottom: 15px;">
  <% with_permission(action: :new) do %>
    <%= link_to t(".new_event"),
      new_admin_event_path,
      class: "btn btn-success" %>
  <% end %>
  <% with_permission(action: :index) do %>
    <%= link_to t(".events"), admin_events_path, class: "btn btn-default" %>
  <% end %>
  <% with_permission(action: :destroy) do %>
    <%= link_to t("empty_bin"), empty_bin_admin_events_path, class: "btn btn-default btn-danger #{'disabled' if @events.empty?}", method: :delete, disabled: @events.empty?, data: {confirm: t('confirm_empty_bin')} %>
  <% end %>
</div>
<div class="clearfix"></div>

<div id="events">
  <% if @events.empty? %>
    <div style="margin-top: 10px;" class="alert alert-warning">
      <%= t("empty_recycle_bin") %>
    </div>
  <% else %>
    <div class="row">
      <div class="col-xs-12 col-sm-6" style="margin-bottom: 8px;"> <%= info_page @events %> </div>
      <div class="col-xs-12 col-sm-6 text-right" style="margin-bottom: 8px;"> <%= paginate @events, remote: true %> </div>
    </div>

    <div class="table-responsive">
      <table class="table table-striped align-middle">
        <thead>
          <tr>
            <th><%= t(".name") %></th>
            <th class="hidden-xs" width="10%"><%= sortable 'events.kind', t(".kind") %></th>
            <th class="hidden-xs hidden-sm" width="20%"><%= sortable 'tags.name', t(".category") %></th>
            <th class="hidden-xs" width="15%"><%= sortable 'calendar_events.deleted_at', t(".deleted_at") %></th>
            <th class="actions text-right"></th>
          </tr>
        </thead>
        <tbody>
          <% @events.each do |event| %>
            <tr id="<%= event.id %>">
              <td>
                <%= event.name %>
                <div class="visible-xs-block table-meta-sub">
                  <span><%= event.kind %></span>
                  <span class="meta-divider">•</span>
                  <span><i class="fa fa-calendar"></i> <%= l(event.deleted_at, :format => :short) %></span>
                </div>
              </td>
              <td class="hidden-xs"><%= event.kind %></td>
              <td class="hidden-xs hidden-sm"><%= raw categories_links(event.categories) %></td>
              <td class="hidden-xs"><%= l(event.deleted_at, :format => :short) %></td>
              <td class="actions text-right">
                <%= render_dropdown_menu do %>
                  <%= recycle_bin_actions event, with_text: true %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="row">
      <div class="col-xs-12 col-sm-6" style="margin-bottom: 8px;"> <%= per_page_links @events, true, :mini %> </div>
      <div class="col-xs-12 col-sm-6 text-right" style="margin-bottom: 8px;"> <%= paginate @events, remote: true %> </div>
    </div>
  <% end %>
</div>
