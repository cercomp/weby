<% title "recycle_bin" %>
<% breadcrumb :news_recycle_bin %>
<div class="text-right btn-group-responsive" style="margin-bottom: 15px;">
  <% with_permission(action: :new) do %>
    <%= link_to t(".new_news"),
      new_admin_news_path,
      class: "btn btn-success" %>
  <% end %>
  <% with_permission(action: :index) do %>
    <%= link_to t(".news"), admin_news_index_path, class: "btn btn-default" %>
  <% end %>
  <% with_permission(action: :destroy) do %>
    <%= link_to t("empty_bin"), empty_bin_admin_news_index_path, class: "btn btn-default btn-danger #{'disabled' if @newslist.empty?}", method: :delete, disabled: @newslist.empty?, data: {confirm: t('confirm_empty_bin')} %>
  <% end %>
</div>
<div class="clearfix"></div>

<div id="news">
  <% if @newslist.empty? %>
    <div style="margin-top: 10px;" class="alert alert-warning">
      <%= t("empty_recycle_bin") %>
    </div>
  <% else %>
    <div class="row">
      <div class="col-xs-12 col-sm-6" style="margin-bottom: 8px;"> <%= info_page @newslist %> </div>
      <div class="col-xs-12 col-sm-6 text-right" style="margin-bottom: 8px;"> <%= paginate @newslist, remote: true %> </div>
    </div>

    <div class="table-responsive">
      <table class="table table-striped align-middle">
        <thead>
          <tr>
            <th><%= t(".title") %></th>
            <th class="hidden-xs" width="15%"><%= sortable 'users.first_name', t(".author") %></th>
            <th class="hidden-xs hidden-sm" width="20%"><%= sortable 'tags.name', t(".category") %></th>
            <th class="hidden-xs" width="15%"><%= sortable 'news.deleted_at', t(".deleted_at") %></th>
            <th class="actions text-right"></th>
          </tr>
        </thead>
        <tbody>
          <% @newslist.each do |news| %>
            <tr id="<%= news.id %>">
              <td>
                <%= news.title %>
                <div class="visible-xs-block table-meta-sub">
                  <span><i class="fa fa-user"></i> <%= news.user.first_name %></span>
                  <span class="meta-divider">•</span>
                  <span><i class="fa fa-calendar"></i> <%= l(news.deleted_at, :format => :short) %></span>
                </div>
              </td>
              <td class="hidden-xs"><%= news.user.first_name %></td>
              <td class="hidden-xs hidden-sm"><%= raw categories_links(news.news_site_for(current_site).categories) %></td>
              <td class="hidden-xs"><%= l(news.deleted_at, :format => :short) %></td>
              <td class="actions text-right">
                <%= render_dropdown_menu do %>
                  <%= recycle_bin_actions news, with_text: true %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="row">
      <div class="col-xs-12 col-sm-6" style="margin-bottom: 8px;"> <%= per_page_links @newslist, true, :mini %> </div>
      <div class="col-xs-12 col-sm-6 text-right" style="margin-bottom: 8px;"> <%= paginate @newslist, remote: true %> </div>
    </div>
  <% end %>
</div>
