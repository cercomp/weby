<% if @newslist.empty? %>
  <div class="alert alert-warning">
    <%= t(".none_news") %>
  </div>
<% else %>
  <div class="row">
    <div class="col-xs-12 col-sm-6" style="margin-bottom: 8px;"> <%= info_page @newslist %> </div>
    <div class="col-xs-12 col-sm-6 text-right" style="margin-bottom: 8px;"> <%= paginate @newslist, remote: true %> </div>
  </div>
  <div class="table-responsive">
    <table class="table table-striped align-middle">
      <thead>
        <tr>
          <th class="center sel-all"><%= check_box_tag :select_all, 1, false %></th>
          <th><%= sortable 'journal_news_i18ns.title', t(".title") %></th>
          <th class="hidden-xs hidden-sm"><%= sortable 'users.first_name', t(".user") %></th>
          <th class="hidden-xs hidden-sm"><%= sortable 'tags.name', t(".category") %></th>
          <th class="hidden-xs"><%= sortable 'journal_news.created_at', t(".created_at") %></th>
          <% with_permission(action: :edit) do %>
            <th class="publish text-center"><%= sortable 'pages.publish', t(".publish") %></th>
            <th class="front hidden-xs hidden-sm text-center"><%= sortable 'journal_news.front', t(".cover") %></th>
            <th class="publish hidden-xs text-center"><%= sortable 'journal_news.status', t(".status") %></th>
          <% end %>
          <th class="center hidden-xs hidden-sm"><%= sortable 'journal_news.view_count', t(".views") %></th>
          <th class="actions text-right"><%#= t(".action")%></th>
        </tr>
      </thead>
      <tbody>
        <% @newslist.each do |news| %>
          <% news_site = news.news_site_for current_site %>
          <tr id="<%= news.id %>" class="<%= 'deactivated' unless news.published? %>">
            <td class="center sel-item"><%= check_box_tag :select_item, news_site.id, false %></td>
            <td>
              <% if news.site_id == current_site.id %>
                <% if check_permission(Journal::Admin::NewsController, [:edit]) %>
                  <%= link_to "#{news.title} #{content_tag(:span, icon(:edit), class: 'oh-c-i')}".html_safe, edit_admin_news_path(news) %>
                <% else %>
                  <%= link_to news.title, news_path(news), target: :_blank %>
                <% end %>
              <% else %>
                <%= icon('retweet') %>
                <%= link_to news.title, news_url(news, subdomain: news.site), target: :_blank %>
              <% end %>
              <div class="visible-xs-block visible-sm-block table-meta-sub">
                <span><i class="fa fa-user"></i> <%= news.user.first_name %></span>
                <span class="meta-divider">•</span>
                <span><i class="fa fa-calendar"></i> <%= l(news.created_at, format: :short) %></span>
                <% if news_site.categories.present? %>
                  <span class="meta-divider">•</span>
                  <span><%= raw categories_links(news_site.categories) %></span>
                <% end %>
              </div>
            </td>
            <td class="hidden-xs hidden-sm"><%= news.user.first_name %></td>
            <td class="hidden-xs hidden-sm"><%= raw categories_links(news_site.categories) %></td>
            <td class="hidden-xs"><%= l(news.created_at, :format => :short) %></td>
            <td class="publish text-center">
              <%= publication_status_news(news, remote: true) %>
            </td>
            <% with_permission(action: :edit) do %>
              <td class="front hidden-xs hidden-sm text-center">
                <%= front_status(news_site, remote: true) %>
              </td>
              <td class="publish hidden-xs text-center">
                <%= news_status(news) %>
              </td>
            <% end %>
            <td class="hidden-xs hidden-sm" style="text-align:center;"><%= news.view_count %></td>
            <td class="actions text-right">
              <%= render_dropdown_menu do %>
                <%= link_to icon('eye-open', text: t('show')), news_url(news, subdomain: news.site), target: :_blank %>
                <% with_permission(action: :unshare) do %>
                  <%= link_to icon('trash', text: t('destroy')), unshare_admin_news_url(news.id), method: :put, data: { confirm: t('are_you_sure_unshare_item', item: news.title) } if news.site_id != current_site.id %>
                <% end %>
                <% if news.site_id == current_site.id && check_permission(Journal::Admin::NewsController, [:new]) %>
                  <%= link_to fa_icon('files-o', text: t('copy')), new_admin_news_path(copy_from: news_site.id) %>
                <% end %>
                <%= make_menu(news, :except => "show", :with_text => true) %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= render_bulk_actions do %>
      <% with_permission(action: :destroy_many) do %>
        <%= link_to icon('trash', text: t('destroy')), destroy_many_admin_news_index_path, class: 'btn btn-sm btn-default destroy-many', method: :delete, data: {confirm: t('are_you_sure_del_many')} %>
      <% end %>
    <% end %>
  </div>
  <div class="row">
    <div class="col-xs-12 col-sm-6" style="margin-bottom: 8px;"> <%= per_page_links @newslist, true, :sm %> </div>
    <div class="col-xs-12 col-sm-6 text-right" style="margin-bottom: 8px;"> <%= paginate @newslist, remote: true %> </div>
  </div>
<% end %>
