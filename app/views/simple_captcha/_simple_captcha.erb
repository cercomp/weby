<%
  key = simple_captcha_options[:field_value].to_s
  image_id = "simple_captcha-#{key[0..10]}"
  hidden_field_id = "simple-captcha-hidden-field-#{image_id}"
  image_url = "/simple_captcha?code=#{key}&time=#{Time.current.to_i}"
  refresh_url = "/simple_captcha?id=#{image_id}"
  placeholder_text = simple_captcha_options[:placeholder].presence || t('simple_captcha.placeholder', default: 'Digite o código da imagem')
  object_name = simple_captcha_options[:object]
  captcha_name = object_name ? "#{object_name}[captcha]" : "captcha"
  captcha_key_name = object_name ? "#{object_name}[captcha_key]" : "captcha_key"
%>

<div class="weby-captcha-wrapper form-group">
  <label class="control-label captcha-label" for="<%= image_id %>_input">
    <i class="fa fa-shield" aria-hidden="true"></i>
    <span><%= t('simple_captcha.label', default: 'Confirmação de segurança') %></span>
  </label>

  <div class="weby-captcha-box">
    <div class="weby-captcha-visual">
      <img src="<%= image_url %>" alt="Código de verificação" id="<%= image_id %>" class="weby-captcha-img" />
      <a href="<%= refresh_url %>"
         class="btn btn-default btn-refresh-captcha"
         data-remote="true"
         title="<%= t('simple_captcha.refresh_button_text', default: 'Atualizar código') %>"
         aria-label="<%= t('simple_captcha.refresh_button_text', default: 'Atualizar código') %>">
        <i class="fa fa-refresh" aria-hidden="true"></i>
      </a>
    </div>

    <div class="weby-captcha-input-wrap">
      <input type="text"
             name="<%= captcha_name %>"
             id="<%= image_id %>_input"
             class="form-control weby-captcha-input"
             autocomplete="off"
             autocorrect="off"
             autocapitalize="characters"
             spellcheck="false"
             required="required"
             maxlength="10"
             placeholder="<%= placeholder_text %>" />
      <input type="hidden"
             name="<%= captcha_key_name %>"
             id="<%= hidden_field_id %>"
             value="<%= key %>"
             autocomplete="off" />
    </div>
  </div>
  <p class="help-block captcha-hint">
    <small><i class="fa fa-info-circle" aria-hidden="true"></i> <%= t('simple_captcha.hint', default: 'Insira os caracteres exibidos acima (não diferencia maiúsculas de minúsculas).') %></small>
  </p>
</div>
