<% if @activity_records.empty? %>
  <div class="alert alert-warning">
    <%= t('.no_activity_records', default: "Nenhum registro de atividade encontrado.") %>
  </div>
<% else %>
  <div class="pull-right"><%= paginate @activity_records, remote: true %></div>
  <div class="pull-left"><%= info_page @activity_records %></div>
  <div class="clearfix"></div>

  <div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
      <thead>
        <tr>
          <th width="15%"><%= t(".created_at", default: "Data / Hora") %></th>
          <th class="hidden-xs" width="15%"><%= t(".site", default: "Site") %></th>
          <th class="hidden-xs hidden-sm" width="18%"><%= t(".user", default: "Usuário") %></th>
          <th width="15%"><%= t(".action", default: "Ação") %></th>
          <th><%= t(".target_item", default: "Item / Arquivo Afetado") %></th>
          <th class="actions text-right"></th>
        </tr>
      </thead>
      <tbody>
        <% @activity_records.each do |activity_record| %>
          <tr>
            <td><small class="text-muted"><%= l(activity_record.created_at, format: :short) %></small></td>
            <td class="hidden-xs"><%= link_to activity_record.site.name, site_url(subdomain: activity_record.site), title: activity_record.site.title, target: :_blank if activity_record.site %></td>
            <td class="hidden-xs hidden-sm"><%= activity_user_view(activity_record) %></td>
            <td><%= activity_action_badge(activity_record) %></td>
            <td>
              <%= activity_item_view(activity_record) %>
              <div class="visible-xs-block visible-sm-block table-meta-sub">
                <% if activity_record.site %>
                  <span><%= link_to activity_record.site.name, site_url(subdomain: activity_record.site), target: :_blank %></span>
                  <span class="meta-divider">•</span>
                <% end %>
                <span><%= activity_user_view(activity_record) %></span>
              </div>
            </td>
            <td class="actions text-right">
              <%= render_dropdown_menu do %>
                <%= link_to(icon("eye", text: t(".show_item", default: "Visualizar item")), build_loggeable_url(activity_record), class: "action-link") if activity_record.is_linkable? %>
                <%= link_to(icon("search", text: t(".details", default: "Detalhes do registro")),
                            admin_activity_record_path(activity_record), class: "action-link" )%>
                <%= link_to(icon("trash", text: t(".destroy", default: "Excluir registro")),
                            admin_activity_record_path(activity_record), method: :delete, data: {confirm: t('are_you_sure_del_item', item: activity_record.screen_name)}, class: "action-link") %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="pull-left"> <%= per_page_links @activity_records, true, :sm %> </div>
  <div class="pull-right"> <%= paginate @activity_records, remote: true %> </div>
  <div class="clearfix"></div>
<% end %>
