<%= form_tag change_roles_admin_users_path, method: "post", id: "subscribe_users", remote: 'true', update: 'enrole' do %>
  <div class="panel panel-default" style="border-radius: 8px; border: 1px solid #e2e8f0; margin-bottom: 20px;">
    <div class="panel-body">
      <div class="row">
        <div class="col-xs-12 col-sm-6" style="margin-bottom: 15px;">
          <h4 style="margin-top: 0; font-size: 14px; font-weight: 600;"><%= t(".enrole_user") %></h4>
          <%= render 'user_search' %>
        </div>
        <div class="col-xs-12 col-sm-6">
          <h4 style="margin-top: 0; font-size: 14px; font-weight: 600;"><%= t('.role') %></h4>
          <ul class="nav" style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 10px 14px; max-height: 240px; overflow-y: auto;">
            <% if @roles.each do |role| %>
              <li>
                <div class="checkbox" style="margin: 4px 0;">
                  <label>
                    <%= check_box_tag 'role_ids[]', role.id %>
                    <%= role.name %>
                  </label>
                </div>
              </li>
            <% end.empty? %>
              <%= link_to t(".new_role"), new_admin_role_path, class: "btn btn-success" %>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  </div>
  <div class="form-actions">
    <%= button_tag t("save"), class: 'btn btn-primary', disable_with: t("please_wait") %>
    <%= link_to t("back"), :back, class: "btn btn-default" %>
  </div>
<% end %>
