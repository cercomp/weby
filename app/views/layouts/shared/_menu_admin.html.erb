<div class="mobile-menu-toggle-bar visible-xs visible-sm">
  <button type="button" class="btn btn-block btn-mobile-menu" data-toggle="collapse" data-target="#menu-admin" aria-expanded="false" aria-controls="menu-admin">
    <i class="fa fa-bars" aria-hidden="true"></i>
    <span class="mobile-menu-text"><%= t('.menu_navigation', default: 'Menu de Navegação') %></span>
    <i class="fa fa-chevron-down pull-right toggle-chevron" aria-hidden="true"></i>
  </button>
</div>

<div id="menu-admin" class="sticky arq-sidebar-menu collapse" data-margin-top="15" data-sticky-for="991">
  <div class="sidebar-menu-card">
    <ul class="nav nav-pills nav-stacked ufg-nav-list">
      <% if current_site %>
        <% if !current_user.has_role_in?(current_site) %>
          <div class="alert alert-warning">
            <%= t('.none_role') %>
          </div>
        <% else %>
          <li class="menu-heading">
            <span class="menu-heading-text"><%= t(".dashboard") %></span>
          </li>
          <%= menu_item_to fa_icon('tachometer fw', text: t(".dashboard")), main_app.site_admin_path %>
          
          <li class="menu-heading">
            <span class="menu-heading-text"><%= t(".administration", default: "Administração") %></span>
          </li>
          <%= menu_item_to fa_icon('users fw', text: t(".users")), main_app.manage_roles_site_admin_users_path, active: (request.path.match?(%r{\A/admin/users\b}) || params[:controller].to_s.include?('users')) if check_permission(Sites::Admin::UsersController, [:manage_roles])%>
          <%= menu_item_to fa_icon('paint-brush fw', text: t(".theme")), main_app.site_admin_skins_path, active: (request.path.match?(%r{\A/admin/(?:skins|styles|components)\b}) || params[:controller].to_s.match?(%r{sites/admin/(?:skins|styles|components)})) if check_permission(Sites::Admin::StylesController, [:index]) || check_permission(Sites::Admin::ComponentsController, [:index]) || (!current_site.restrict_theme && check_permission(Sites::Admin::SkinsController, [:index])) %>
          <%= menu_item_to fa_icon('list-alt fw', text: t(".activity_records")), main_app.site_admin_activity_records_path, active: (request.path.match?(%r{\A/admin/activity_records\b}) || params[:controller].to_s.include?('activity_records')) if check_permission(Sites::Admin::ActivityRecordsController, [:index]) %>
          <%= menu_item_to fa_icon('plug fw', text: t(".extensions")), main_app.site_admin_extensions_path, active: (request.path.match?(%r{\A/admin/extensions\b}) || params[:controller].to_s.include?('extensions')) if check_permission(Sites::Admin::ExtensionsController, [:index]) %>
          <%= menu_item_to fa_icon('download fw', text: t(".backup")), main_app.site_admin_backups_path, active: (request.path.match?(%r{\A/admin/backups\b}) || params[:controller].to_s.include?('backups')) if current_user.is_admin? %>
          <%= menu_item_to fa_icon('cog fw', text: t(".settings")), main_app.edit_site_admin_path, active: (request.path.match?(%r{\A/admin/edit\b}) || (params[:controller].to_s == 'sites' && params[:action].to_s == 'edit')) if check_permission(SitesController, [:edit]) %>

          <li class="menu-heading">
            <span class="menu-heading-text"><%= t(".contents") %></span>
          </li>
          <%= build_admin_menu %>
        <% end %>
      <% else %>
        <% if current_user.is_admin? %>
          <li class="menu-heading">
            <span class="menu-heading-text"><%= t(".dashboard") %></span>
          </li>
          <%= menu_item_to fa_icon('tachometer fw', text: t(".dashboard")), main_app.admin_path %>

          <li class="menu-heading">
            <span class="menu-heading-text"><%= t(".management", default: "Gestão Global") %></span>
          </li>
          <%= menu_item_to fa_icon('desktop fw', text: t(".sites")), main_app.admin_sites_path %>
          <%= menu_item_to fa_icon('sitemap fw', text: t(".groupings")), main_app.admin_groupings_path %>
          <%= menu_item_to fa_icon('users fw', text: t(".users")), main_app.admin_users_path %>
          <%= menu_item_to fa_icon('bell-o fw', text: t(".notifications")), main_app.admin_notifications_path %>
          <%= menu_item_to fa_icon('list-alt fw', text: t(".activity_records")), main_app.admin_activity_records_path %>
          <%= menu_item_to fa_icon('laptop fw', text: t(".apps")), main_app.admin_apps_path %>
          <%= menu_item_to fa_icon('cog fw', text: t(".settings")), main_app.admin_settings_path %>
        <% end %>
      <% end %>
    </ul>
  </div>
</div>
