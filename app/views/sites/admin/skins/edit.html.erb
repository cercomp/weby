<% title ".themes" %>
<% breadcrumb :skins_edit %>

<%= simple_form_for [:site_admin, @skin] do |f| %>

  <% if @theme.variables.blank? %>
    <div class="alert alert-warning">
      <%= t(".no_settings") %>
    </div>

    <div class="form-actions">
      <%= link_to t("back"), :back, class: "btn btn-default" %>
    </div>
  <% else %>

    <% @theme.variables.each do |name, config| %>
      <div class="form-group string optional">
        <label class="string optional" for="code"><%= t('themes.'+@skin.theme+'.variables.'+name) %></label>
        <% if config['type'] == 'color' %>
          <% all_colors = @skin.get_all_color_options(name) %>
          <% grouped_options = all_colors.group_by{ |option_name, object| object['group'] } %>

          <% grouped_options.each do |group, option| %>
            <% unless group == 'custom' %>
              <%= "<div class=\"group-title\">#{config['groups'][group][current_locale.to_s]}</div>".html_safe if group.present? %>

              <div class="color-pick-container" data-name="<%= name %>">
                <% option.each do |option_name, object| %>
                  <div class="color-pick-option">
                    <%= radio_button_tag name, option_name, @skin.get_variable(name) == option_name, id: "color-#{option_name}", data: { main_color: object['main'] } %>
                    <label style="background-color: <%= object['main'] %>;" for="<%= "color-#{option_name}" %>"></label>
                    <div class="sub-color"></div>
                  </div>
                <% end %>
              </div>
            <% end %>
          <% end %>

          <% if current_user.is_admin? %>
            <div class="custom-color-form">
              <h5><%= t('.add_custom_color') %></h5>

              <label for="skin_color_value_<%= name %>"><%= t('.color_value') %></label>

              <div class="color-picker-wrapper">
                <input
                  type="color"
                  id="skin_color_value_<%= name %>"
                  name="skin[color_value_<%= name %>]"
                  value="#BF4040"
                  class="hidden-color-input"
                >

                <button type="button" id="openColorPicker_<%= name %>" class="btn-color">
                  Escolher Cor
                </button>

                <span id="colorPreview_<%= name %>" class="color-preview"></span>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <div class="form-actions">
      <%= f.submit class: 'btn btn-primary' %>
      <%= link_to t("back"), :back, class: "btn btn-default" %>
    </div>

  <% end %>
<% end %>

<% content_for :javascripts do %>
  <%= javascript_include_tag 'admin/custom_colors' %>
<% end %>
