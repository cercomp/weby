<div class="row">
  <div class="col-xs-12 col-sm-6" style="margin-bottom: 8px;"><%= info_page @albums %></div>
  <div class="col-xs-12 col-sm-6 text-right" style="margin-bottom: 8px;"><%= paginate @albums, :remote => true %></div>
</div>
<div class="table-responsive">
  <table class='table table-striped table-condensed align-middle'>
    <thead>
      <th class="center sel-all" width="1%"><%= check_box_tag :select_all, 1, false %></th>
      <th width="10%"><%= t(".cover") %></th>
      <th><%= sortable 'album_i18ns.title', t(".title") %></th>
      <th class="hidden-xs hidden-sm" width="12%"><%= sortable 'users.first_name', t(".author") %></th>
      <th class="hidden-xs hidden-sm" width="15%"><%= sortable 'tags.name', t(".categories") %></th>
      <th class="hidden-xs hidden-sm" width="15%"><%= sortable 'album_tags.name', t(".tags") %></th>
      <th class="hidden-xs" width="15%"><%= sortable 'albums.created_at', t(".created_at") %></th>
      <% with_permission(action: :edit) do %>
        <th width="5%"><%= sortable 'albums.publish', t(".publish") %></th>
      <% end %>
      <th width="5%" class="center hidden-xs hidden-sm"><%= sortable 'albums.view_count', t(".views") %></th>
      <th width="5%" class="center hidden-xs hidden-sm"><%= sortable 'albums.photos_count', t(".photos") %></th>
      <th width="5%" class="actions text-right"><%#= t(".action")%></th>
    </thead>
    <tbody>
      <% @albums.each do |album| %>
        <tr id="<%= album.id %>"<%= ' class="deactivated"'.html_safe unless album.publish? %>>
          <td class="center sel-item"><%= check_box_tag :select_item, album.id, false %></td>
          <td><%= image_tag album.get_cover_photo.image.url(:t), style: 'width: 48px; height: 48px;' if album.get_cover_photo.present? %></td>
          <td>
            <% if check_permission(Sites::Admin::AlbumsController, [:edit]) %>
              <%= link_to "#{album.title} #{content_tag(:span, icon(:edit), class: 'oh-c-i')}".html_safe, edit_site_admin_album_path(album) %>
            <% else %>
              <%= album.title %>
            <% end %>
            <div class="visible-xs-block visible-sm-block table-meta-sub">
              <span><i class="fa fa-user"></i> <%= album.user.first_name %></span>
              <span class="meta-divider">•</span>
              <span><i class="fa fa-calendar"></i> <%= l(album.created_at, format: :short) %></span>
            </div>
          </td>
          <td class="hidden-xs hidden-sm"><%= album.user.first_name %></td>
          <td class="hidden-xs hidden-sm"><%= raw categories_links(album.categories) %></td>
          <td class="hidden-xs hidden-sm"><%= album.album_tags.map(&:name).join(', ') %></td>
          <td class="hidden-xs"><%= l(album.created_at, :format => :short) %></td>
          <% with_permission(action: :edit) do %>
            <td class="publish">
              <%= publication_status_page(album, remote: true) %></td>
          <% end %>
          <td class="hidden-xs hidden-sm" style="text-align:center;"><%= album.view_count.to_i %></td>
          <td class="hidden-xs hidden-sm" style="text-align:center;"><%= album.photos_count.to_i %></td>
          <td class="actions">
            <%= render_dropdown_menu do %>
              <%= link_to icon('eye-open', text: t('show')), site_album_path(album.slug), target: :_blank %>
              <%= make_menu(album, :except => "show", :with_text => true, delete_confirm: t('.confirm_destroy', album: album.screen_name)) %>
              <% with_permission(action: :edit) do %>
                <%= link_to icon('picture', text: t('.photos')), edit_site_admin_album_path(album, anchor: 'tab-photos') %>
              <% end %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= render_bulk_actions do %>
    <% with_permission(action: :destroy_many) do %>
      <%= link_to icon('trash', text: t('destroy')), destroy_many_site_admin_albums_path, class: 'btn btn-sm btn-default destroy-many', method: :delete, data: {confirm: t('are_you_sure_del_many')} %>
    <% end %>
  <% end %>
</div>
<div class="row">
  <div class="col-xs-12 col-sm-6" style="margin-bottom: 8px;"><%= per_page_links @albums, true, :sm%></div>
  <div class="col-xs-12 col-sm-6 text-right" style="margin-bottom: 8px;"><%= paginate @albums, remote: true %></div>
</div>
