<% if @pages.empty? %>
  <div class="alert alert-warning">
    <%= t(".none_page") %>
  </div>
<% else %>
  <div class="row">
    <div class="col-xs-12 col-sm-6" style="margin-bottom: 8px;"> <%= info_page @pages %> </div>
    <div class="col-xs-12 col-sm-6 text-right" style="margin-bottom: 8px;"> <%= paginate @pages, remote: true %> </div>
  </div>
  <div class="table-responsive">
    <table class="table table-striped align-middle">
      <thead>
        <tr>
          <th class="center sel-all"><%= check_box_tag :select_all, 1, false %></th>
          <th><%= t(".title") %></th>
          <th class="hidden-xs" width="15%"><%= sortable 'users.first_name', t(".author") %></th>
          <th class="hidden-xs" width="20%"><%= sortable 'pages.created_at', t(".created_at") %></th>
          <% with_permission(action: :show) do %>
            <th class="publish text-center" width="8%"><%= sortable 'pages.publish', t(".publish") %></th>
          <% end %>
          <th width="8%" class="center hidden-xs hidden-sm"><%= sortable 'pages.view_count', t(".views") %></th>
          <th class="actions text-right"><%#= t(".action")%></th>
        </tr>
      </thead>
      <tbody>
        <% @pages.each do |page| %>
        <tr id="<%= page.id %>"<%= ' class="deactivated"'.html_safe unless page.publish? %>>
          <td class="center sel-item"><%= check_box_tag :select_item, page.id, false %></td>
          <td>
            <%= title_with_flags(page) %>
            <div class="visible-xs-block table-meta-sub">
              <span><i class="fa fa-user"></i> <%= page.user.first_name %></span>
              <span class="meta-divider">•</span>
              <span><i class="fa fa-calendar"></i> <%= l(page.created_at, format: :short) %></span>
            </div>
          </td>
          <td class="hidden-xs"><%= page.user.first_name %></td>
          <td class="hidden-xs"><%= l(page.created_at, :format => :short) %></td>
          <% with_permission(action: :show) do %>
            <td class="publish text-center">
              <%= publication_status_page(page, remote: true) %></td>
          <% end %>
          <td class="hidden-xs hidden-sm" style="text-align:center;"><%= page.view_count %></td>
          <td class="actions text-right">
            <%= render_dropdown_menu do %>
              <%= link_to icon('eye-open', text: t('show')), site_page_path(page), target: :_blank %>
              <% with_permission(action: :new) do %>
                <%= link_to fa_icon('files-o', text: t('copy')), new_site_admin_page_path(copy_from: page.id) %>
              <% end %>
              <%= make_menu(page, :except => "show", :with_text => true) %>
            <% end %>
          </td>
        </tr>
      <% end %>
      </tbody>
    </table>
    <%= render_bulk_actions do %>
      <% with_permission(action: :destroy_many) do %>
        <%= link_to icon('trash', text: t('destroy')), destroy_many_site_admin_pages_path, class: 'btn btn-sm btn-default destroy-many', method: :delete, data: {confirm: t('are_you_sure_del_many')} %>
      <% end %>
    <% end %>
  </div>

  <div class="row">
    <div class="col-xs-12 col-sm-6" style="margin-bottom: 8px;"> <%= per_page_links @pages, true, :sm %> </div>
    <div class="col-xs-12 col-sm-6 text-right" style="margin-bottom: 8px;"> <%= paginate @pages, remote: true %> </div>
  </div>
<% end %>
