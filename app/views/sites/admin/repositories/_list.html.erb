<%= render 'view_picker' %>
<div class="row">
  <div class="col-xs-12 col-sm-6" style="margin-bottom: 8px;"><%= info_page @repositories %></div>
  <div class="col-xs-12 col-sm-6 text-right" style="margin-bottom: 8px;"><%= paginate @repositories, :remote => true %></div>
</div>
<div class="table-responsive">
  <table class='table table-striped table-condensed align-middle'>
    <thead>
      <th class="center sel-all" width="1%"><%= check_box_tag :select_all, 1, false %></th>
      <th width="70"><%= sortable 'archive_file_name', t(".archive") %></th>
      <th><%= sortable 'title', t(".title") %></th>
      <th class="hidden-xs hidden-sm"><%= sortable 'description', t(".description") %></th>
      <th class="hidden-xs" width="15%"><%= sortable 'archive_content_type', t(".type") %></th>
      <th class="actions text-right"></th>
    </thead>
    <tbody>
      <% @repositories.each do |repository| %>
        <tr>
          <td class="center sel-item"><%= check_box_tag :select_item, repository.id, false %></td>
          <td><%= weby_file_view(repository, :t, "54", "54", target: '_blank') %></td>
          <td>
            <% if check_permission(Sites::Admin::RepositoriesController, [:edit]) %>
              <%= link_to "#{repository.title} #{content_tag(:span, icon(:edit), class: 'oh-c-i')}".html_safe, edit_site_admin_repository_path(repository) %>
            <% else %>
              <%= repository.title %>
            <% end %>
            <div class="visible-xs-block table-meta-sub">
              <span><%= repository.archive_content_type %></span>
              <% if repository.uploader_user.present? %>
                <span class="meta-divider">•</span>
                <span><i class="fa fa-user"></i> <%= repository.uploader_user %></span>
              <% end %>
            </div>
          </td>
          <td class="hidden-xs hidden-sm">
            <%= repository.description %>
            <% if repository.uploader_user.present? %>
              <br><small class="text-muted"><i class="fa fa-user"></i> <%= repository.uploader_user %></small>
            <% end %>
          </td>
          <td class="hidden-xs"><%= repository.archive_content_type %></td>
          <td class="actions text-right">
            <%= render_dropdown_menu do %>
              <% if repository.image? && check_permission(Sites::Admin::RepositoriesController, [:crop]) %>
                <%= link_to icon('scissors', text: t('.crop_image')), crop_site_admin_repository_path(repository) %>
              <% end %>
              <%= link_to icon('history', text: t('.history', default: 'Histórico')), site_admin_activity_records_path(search: repository.archive_file_name) %>
              <%= raw make_menu(repository) %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= render_bulk_actions do %>
    <% with_permission(action: :destroy_many) do %>
      <%= link_to icon('trash', text: t('destroy')), destroy_many_site_admin_repositories_path, class: 'btn btn-sm btn-default destroy-many', method: :delete, data: {confirm: t('are_you_sure_del_many')} %>
    <% end %>
  <% end %>
</div>
<div class="row">
  <div class="col-xs-12 col-sm-6" style="margin-bottom: 8px;"><%= per_page_links @repositories, true, :sm%></div>
  <div class="col-xs-12 col-sm-6 text-right" style="margin-bottom: 8px;"><%= paginate @repositories, remote: true %></div>
</div>
