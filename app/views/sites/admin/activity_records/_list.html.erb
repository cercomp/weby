<% if @activity_records.empty? %>
  <div class="alert alert-warning">
    <%= t('.no_activity_records', default: "Nenhum registro de atividade encontrado.") %>
  </div>
<% else %>
  <div class="pull-left"> <%= info_page @activity_records %> </div>
  <div class="pull-right"> <%= paginate @activity_records, remote: true %> </div>
  <div class="clearfix"></div>

  <table class="table table-striped table-hover align-middle">
    <thead>
      <tr>
        <th width="15%"><%= t(".created_at", default: "Data / Hora") %></th>
        <th width="20%"><%= t(".user", default: "Usuário") %></th>
        <th width="18%"><%= t(".action", default: "Ação / Operação") %></th>
        <th width="40%"><%= t(".target_item", default: "Item / Arquivo Afetado") %></th>
        <th width="7%" class="text-right"></th>
      </tr>
    </thead>
    <tbody>
      <% @activity_records.each do |activity_record| %>
        <tr>
          <td>
            <small class="text-muted"><%= l(activity_record.created_at, format: :short) %></small>
          </td>
          <td>
            <%= activity_user_view(activity_record) %>
          </td>
          <td>
            <%= activity_action_badge(activity_record) %>
          </td>
          <td>
            <%= activity_item_view(activity_record) %>
          </td>
          <td class="text-right">
            <%= render_dropdown_menu do %>
              <%= link_to(icon("eye", text: t(".show_item", default: "Visualizar item")), build_loggeable_url(activity_record), class: 'action-link') if activity_record.is_linkable? %>
              <%= link_to(icon("search", text: t(".details", default: "Detalhes do registro")),
                          site_admin_activity_record_path(activity_record), class: 'action-link') %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="pull-left"> <%= per_page_links @activity_records, true, :sm %> </div>
  <div class="pull-right"> <%= paginate @activity_records, remote: true %> </div>
  <div class="clearfix"></div>
<% end %>
