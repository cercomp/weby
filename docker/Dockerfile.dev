FROM ruby:3.3.14-slim-bookworm

RUN apt-get update && \
    apt-get install -y --no-install-recommends tzdata imagemagick libpng-dev libpq-dev libncurses-dev libffi-dev curl build-essential libssl-dev libreadline-dev zlib1g-dev zlib1g libsqlite3-dev libmagickwand-dev libxslt-dev ghostscript ntpdate nodejs file git && \
    rm -rf /var/lib/apt/lists/*

ENV TZ=America/Sao_Paulo
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

WORKDIR /opt/weby

RUN git config --global url."https://github.com/".insteadOf "git://github.com/" && \
    git config --global url."https://github.com/".insteadOf "http://github.com/"

RUN gem install bundler -v '2.4.20'

COPY Gemfile Gemfile.lock ./
COPY vendor/engines ./vendor/engines/
COPY vendor/gems ./vendor/gems/

RUN bundle install --jobs 4 --retry 3

COPY . /opt/weby

EXPOSE 3000

CMD ["bundle", "exec", "rails", "server", "-b", "0.0.0.0", "-p", "3000"]
